{
  "name": "LinkedIn – CSR lead discovery (Sales Navigator)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "csr-leads",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "6c0cbf5a-d9c0-5f27-b44c-e770cf84f49d",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "3f71a819-9038-5ccd-9fcc-91aa1c4cc391",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LinkedIn webhook"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst company = String(body.company ?? '').trim();\nif (!company) throw new Error('Body must be {\"company\": \"<name>\", \"cin\": \"<optional CIN>\"}');\nconst endpoint = 'http://li-salesnav:8000/mcp';\n// Two Sales Navigator searches per company: CSR/sustainability roles, then HR (often owns CSR in India).\nconst searches = [\n  { pass: 'csr', keywords: 'CSR OR \"corporate social responsibility\" OR sustainability OR ESG OR foundation OR \"social impact\" OR \"community affairs\"' },\n  { pass: 'hr',  keywords: '\"human resources\" OR CHRO OR \"HR head\" OR \"people officer\"' },\n];\nreturn searches.map(s => ({ json: { company, cin: body.cin ?? '', endpoint, ...s } }));"
      },
      "id": "2bb4bad2-66cd-58bd-adce-2eae06202c6f",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "endpointUrl": "={{ $json.endpoint }}",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "linkedin_search_leads"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ company: $json.company, keywords: $json.keywords }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "df9f574b-a38a-586e-b534-4962fe3af1a0",
      "name": "Sales Navigator search",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into linkedin.scrape_log (account, tool, target, ok, error) values ('salesnav', 'linkedin_search_leads', $1, $2, $3)",
        "options": {
          "queryReplacement": "={{ [$('Config').item.json.company + ' / ' + $('Config').item.json.pass, !$json.error, $json.error ? String($json.error.message ?? $json.error) : null] }}"
        }
      },
      "id": "2419ab44-3243-58f5-b0a4-ed08a5983f89",
      "name": "Log searches",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "LinkedIn Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const leads = new Map();\nconst errors = [];\nfor (const item of $('Sales Navigator search').all()) {\n  if (item.json.error) { errors.push(String(item.json.error.message ?? item.json.error)); continue; }\n  const r = item.json.structuredContent ?? item.json.content?.find(c => c.type === 'text')?.text ?? item.json;\n  const res = typeof r === 'string' ? JSON.parse(r) : r;\n  for (const l of res.leads ?? []) if (l.salesNavUrl) leads.set(l.salesNavUrl, l);\n}\nconst cfg = $('Config').first().json;\nconst list = [...leads.values()];\nif (!list.length) return [{ json: { company: cfg.company, cin: cfg.cin, leads: [], errors } }];\nconst text = 'We want to start a CSR partnership with ' + cfg.company + '. Score each Sales Navigator lead below.\\n\\n' + JSON.stringify(list);\nreturn [{ json: { company: cfg.company, cin: cfg.cin, leads: list, errors, text } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "2207d3de-3326-5ac9-9afd-1869dc09c1d5",
      "name": "Collect leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b48ca468-b7d6-5939-b95b-0c6eff664b85",
              "leftValue": "={{ $json.leads }}",
              "rightValue": "",
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4373211-7c09-5466-b758-50dc0a86498a",
      "name": "Any leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { company: $json.company, leads: [], errors: $json.errors } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "fc1bb10b-e9b0-5071-9ca5-22f91d5da73a",
      "name": "Respond no leads",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1320,
        460
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"leads\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"salesNavUrl\": {\n            \"type\": \"string\"\n          },\n          \"score\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"maximum\": 10\n          },\n          \"match_reason\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"salesNavUrl\",\n          \"score\",\n          \"match_reason\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"leads\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You score Sales Navigator leads 0-10 for how likely they own or strongly influence CSR spend at the named company: CSR head / foundation head / sustainability or ESG head = 8-10; CHRO or senior HR who may hold CSR = 6-8; junior or unrelated roles, or a different employer = 0-3. Return every lead with its salesNavUrl unchanged and a one-line match_reason."
        }
      },
      "id": "aa34426f-a262-5ed4-87c4-4e35ddca880a",
      "name": "Rank leads",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1320,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Collect leads').first().json;\nconst scored = $json.output?.leads;\nif (!Array.isArray(scored)) throw new Error('Ranking returned nothing: ' + JSON.stringify($json).slice(0, 500));\nconst byUrl = new Map(scored.map(x => [x.salesNavUrl, x]));\nconst ranked = prev.leads\n  .map(l => ({ ...l, ...(byUrl.get(l.salesNavUrl) ?? { score: 0, match_reason: 'not ranked' }) }))\n  .filter(l => l.score >= 5)\n  .sort((a, b) => b.score - a.score);\nreturn [{ json: { company: prev.company, cin: prev.cin, ranked, leadsJson: JSON.stringify(ranked), errors: prev.errors } }];"
      },
      "id": "1a7f79b4-faef-59ef-9b47-9b5d791f86ae",
      "name": "Merge ranking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select linkedin.add_csr_leads($1, $2, $3::jsonb) as saved",
        "options": {
          "queryReplacement": "={{ [$json.company, $json.cin, $json.leadsJson] }}"
        }
      },
      "id": "4a240201-85bd-5056-bff2-54cfcd7dc244",
      "name": "Save leads",
