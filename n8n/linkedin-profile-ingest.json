    {
      "parameters": {
        "jsCode": "const r = $json.structuredContent ?? $json.content?.find(c => c.type === 'text')?.text ?? $json;\nconst cfg = $('Config').first().json;\nconst schema = {\n  type: 'object',\n  properties: {\n    full_name: { type: 'string' }, headline: { type: 'string' }, location: { type: 'string' },\n    about: { type: 'string' }, current_company: { type: 'string' }, current_title: { type: 'string' },\n    employment: { type: 'array', items: { type: 'object', properties: {\n      company_name: { type: 'string' }, company_linkedin_url: { type: 'string' }, title: { type: 'string' },\n      employment_type: { type: 'string' }, location: { type: 'string' },\n      start_date: { type: 'string', description: 'YYYY-MM or YYYY' },\n      end_date: { type: 'string', description: 'YYYY-MM or YYYY; empty if current' },\n      is_current: { type: 'boolean' }, description: { type: 'string' } },\n      required: ['company_name', 'title'] } },\n    education: { type: 'array', items: { type: 'object', properties: {\n      school: { type: 'string' }, school_linkedin_url: { type: 'string' }, degree: { type: 'string' },\n      field_of_study: { type: 'string' }, start_year: { type: 'integer' }, end_year: { type: 'integer' } },\n      required: ['school'] } } },\n  required: ['full_name', 'employment', 'education'] };\nconst request = {\n  model: 'claude-haiku-5-5', max_tokens: 16000,\n  tools: [{ name: 'save_profile', description: 'Save the structured LinkedIn profile.', input_schema: schema }],\n  tool_choice: { type: 'tool', name: 'save_profile' },\n  messages: [{ role: 'user', content:\n    'Below is raw text scraped from a LinkedIn profile (main page plus experience and education sections). ' +\n    'Extract every job and every degree, newest first. A company with several roles yields one entry per role. ' +\n    'Use only facts present in the text; leave a field out when unknown. Profile URL: ' + cfg.url +\n    '\\n\\n' + JSON.stringify(r) }] };\nreturn [{ json: { request, raw: r } }];"
      },
      "id": "2d93ab2e-dc4a-5ea7-bd88-1b6d9533cc45",
      "name": "Build extraction request",
      "type": "n8n-nodes-base.code",
