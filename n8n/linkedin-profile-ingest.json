    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst toolUse = ($json.content ?? []).find(c => c.type === 'tool_use');\nif (!toolUse) throw new Error('Extraction returned no structured profile: ' + JSON.stringify($json).slice(0, 500));\nconst payload = { ...toolUse.input, linkedin_url: cfg.url, raw: $('Build extraction request').first().json.raw, source: cfg.account };\nreturn [{ json: { payload: JSON.stringify(payload) } }];"
      },
      "id": "b80d9080-1065-5de8-b65e-45cf3ad3c915",
      "name": "Build DB payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
