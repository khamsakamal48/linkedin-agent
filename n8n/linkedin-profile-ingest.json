    {
      "parameters": {
        "jsCode": "// Scraper output (page text per section) goes to the extractor as one string; raw is kept for the person.raw column.\nconst raw = $json.structuredContent ?? $json.content?.find(c => c.type === 'text')?.text ?? $json;\nconst cfg = $('Config').first().json;\nreturn [{ json: { raw, text: 'Profile URL: ' + cfg.url + '\\n\\n' + (typeof raw === 'string' ? raw : JSON.stringify(raw)) } }];"
      },
      "id": "2d93ab2e-dc4a-5ea7-bd88-1b6d9533cc45",
      "name": "Prepare text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        260
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"full_name\": {\n      \"type\": \"string\"\n    },\n    \"headline\": {\n      \"type\": \"string\"\n    },\n    \"location\": {\n      \"type\": \"string\"\n    },\n    \"about\": {\n      \"type\": \"string\"\n    },\n    \"current_company\": {\n      \"type\": \"string\"\n    },\n    \"current_title\": {\n      \"type\": \"string\"\n    },\n    \"employment\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"company_name\": {\n            \"type\": \"string\"\n          },\n          \"company_linkedin_url\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"employment_type\": {\n            \"type\": \"string\"\n          },\n          \"location\": {\n            \"type\": \"string\"\n          },\n          \"start_date\": {\n            \"type\": \"string\",\n            \"description\": \"YYYY-MM or YYYY\"\n          },\n          \"end_date\": {\n            \"type\": \"string\",\n            \"description\": \"YYYY-MM or YYYY; empty if current\"\n          },\n          \"is_current\": {\n            \"type\": \"boolean\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"company_name\",\n          \"title\"\n        ]\n      }\n    },\n    \"education\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"school\": {\n            \"type\": \"string\"\n          },\n          \"school_linkedin_url\": {\n            \"type\": \"string\"\n          },\n          \"degree\": {\n            \"type\": \"string\"\n          },\n          \"field_of_study\": {\n            \"type\": \"string\"\n          },\n          \"start_year\": {\n            \"type\": \"integer\"\n          },\n          \"end_year\": {\n            \"type\": \"integer\"\n          }\n        },\n        \"required\": [\n          \"school\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"full_name\",\n    \"employment\",\n    \"education\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You turn raw text scraped from a LinkedIn profile (main page plus experience and education sections) into structured data. Extract every job and every degree, newest first. A company with several roles yields one entry per role. Use only facts present in the text; leave a field out when unknown."
        }
      },
      "id": "e3a00e86-1e9c-53f0-b8bc-f2db589a3a5b",
      "name": "Structure profile",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        2200,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst out = $json.output;\nif (!out?.full_name || !Array.isArray(out.employment)) throw new Error('Extraction returned no structured profile: ' + JSON.stringify($json).slice(0, 500));\nconst payload = { ...out, linkedin_url: cfg.url, raw: $('Prepare text').first().json.raw, source: cfg.account };\nreturn [{ json: { payload: JSON.stringify(payload) } }];"
      },
      "id": "b80d9080-1065-5de8-b65e-45cf3ad3c915",
      "name": "Build DB payload",
