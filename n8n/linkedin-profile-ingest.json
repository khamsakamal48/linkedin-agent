    {
      "parameters": {
        "jsCode": "// Account this workflow scrapes with. To add an account, duplicate the workflow\n// and change these three values (see README \"Adding accounts\").\nconst cfg = { account: 'acct-a', endpoint: 'http://li-profile-acct-a:8080/mcp', dailyCap: 80, maxAgeDays: 90 };\nconst body = $json.body ?? $json;\nconst url = String(body.url ?? '').trim();\nif (!/linkedin\\.com\\/in\\/[^/?#]+/i.test(url)) throw new Error('Body must be {\"url\": \"https://www.linkedin.com/in/<id>/\"}');\nreturn [{ json: { ...cfg, url, force: body.force === true } }];"
      },
      "id": "2bb4bad2-66cd-58bd-adce-2eae06202c6f",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from linkedin.fresh_profile($1, $2)",
        "options": {
          "queryReplacement": "={{ [$json.url, $json.maxAgeDays] }}"
        }
      },
      "id": "722bcf6e-1f63-577c-8598-d5e963ad06bd",
      "name": "Cache lookup",
