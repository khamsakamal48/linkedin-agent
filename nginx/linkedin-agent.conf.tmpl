# Rendered by scripts/install-nginx.sh (envsubst). Do not edit the rendered copy.
# TLS lines are added by certbot (--nginx).

# No MCP endpoints here: n8n reaches the MCP servers on the podman network, and Claude connects to n8n.

# --- LinkedIn login page for profile accounts (scripts/add-account.sh) ---
server {
    listen 80;
    server_name ${LOGIN_DOMAIN};

    auth_basic "LinkedIn account login";
    auth_basic_user_file ${REPO_DIR}/nginx/.htpasswd-login;

    location / {
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
}

# --- Sales Navigator browser (log in once, watch it work) ---
