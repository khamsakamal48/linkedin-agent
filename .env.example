# Copy to .env and fill in. Never commit .env.

# Add "salesnav" once the Sales Navigator account is ready (accounts/salesnav.env exists)
COMPOSE_PROFILES=

# Pinned upstream image for profile scraping (bump deliberately, test first)
LI_PROFILE_IMAGE=docker.io/stickerdaniel/linkedin-mcp-server:4.27.0

# Postgres (n8n connects to host li-postgres, port 5432, on the "linkedin" network)
PG_DB=linkedin
PG_USER=linkedin
PG_PASSWORD=

# Token Claude sends to the MCP endpoints: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Public names served by Nginx (DNS A records -> this server)
MCP_DOMAIN=mcp.example.com
LOGIN_DOMAIN=li-login.example.com
SALESNAV_LOGIN_DOMAIN=sn-login.example.com

# Sales Navigator daily budgets (enforced inside the server)
SN_DAILY_SEARCHES=30
SN_DAILY_PROFILE_VIEWS=80
